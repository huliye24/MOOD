{
  "name": "mood",
  "version": "0.2.0",
  "private": true,
  "description": "MOOD - Open coordination protocol for contribution verification",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:node": "npm --prefix apps/node-client run dev",
    "dev:relay": "npm --prefix services/relay start",
    "build": "npm --prefix apps/web run install:ci && npm --prefix apps/web run build && node scripts/promote-site-build.mjs",
    "build:web": "npm --prefix apps/web run build",
    "build:node": "npm --prefix apps/node-client run build",
    "build:node:win": "npm --prefix apps/node-client run build:win",
    "build:node:mac": "npm --prefix apps/node-client run build:mac",
    "build:node:linux": "npm --prefix apps/node-client run build:linux",
    "build:relay": "cd services/relay && npm install --omit=dev",
    "test": "npm --prefix apps/web run test",
    "test:web": "npm --prefix apps/web run test",
    "test:protocol": "npm install --prefix protocol/contribution && npm test --prefix protocol/contribution",
    "test:node": "npm install --prefix packages/node-runtime && npm test --prefix packages/node-runtime",
    "test:relay": "npm install --prefix services/relay && npm test --prefix services/relay",
    "test:three-node": "node testnet/three-node/run-three-node-test.mjs",
    "testnet:create": "node testnet/three-node/create-testnet.mjs",
    "lint": "npm --prefix apps/web run lint",
    "setup": "node scripts/setup.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "protocol/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1"
  },
  "keywords": [
    "mood",
    "protocol",
    "coordination",
    "node",
    "federated"
  ],
  "license": "AGPL-3.0"
}
