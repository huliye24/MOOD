{
  "name": "@mood/mood-desktop",
  "version": "0.1.0-alpha.1",
  "description": "MOOD Node Desktop Client (Experimental GUI) - One-click node for MOOD Protocol v0.2. The CLI is the primary MOOD interface.",
  "main": "desktop/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "mood",
    "node",
    "desktop",
    "electron",
    "protocol"
  ],
  "license": "AGPL-3.0",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "@mood/node-runtime": "0.1.0-alpha.1",
    "electron-log": "^5.2.0"
  },
  "build": {
    "appId": "com.mood.node",
    "productName": "MOOD Node",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "renderer/**/*",
      "preload/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
